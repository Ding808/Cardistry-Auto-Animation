    { "Name": "Interchange", "Enabled": true, "TargetAllowList": ["Editor"] },
    { "Name": "InterchangeEditor", "Enabled": true, "TargetAllowList": ["Editor"] }
  ],
  "Modules": [
    { "Name": "CardistryCapture", "Type": "Runtime", "LoadingPhase": "Default", "PlatformAllowList": ["Win64"] },
    { "Name": "CardistryCaptureEditor", "Type": "Editor", "LoadingPhase": "Default", "PlatformAllowList": ["Win64"] }
  ]
}
